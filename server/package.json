{
  "name": "ts-node-sql-project",
  "version": "1.0.0",
  "description": "A Node.js TypeScript project with SQL in Docker",
  "main": "dist/server.js",
  "scripts": {
    "seed": "ts-node src/scripts/seedMonthlyRates.ts",
    "start": "node dist/server.js",
    "dev": "nodemon -L -e ts --exec \"npm run build && npm start\"",
    "build": "tsc",
    "test": "jest --coverage --passWithNoTests",
